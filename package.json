{
  "name": "blies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests docs *.ts *.mjs *.json README.md",
    "test:vercel": "playwright test --config=playwright.vercel.config.ts",
    "test:storage-failure": "playwright test --config=playwright.storage-failure.config.ts",
    "test:figma": "playwright test --config=playwright.figma.config.ts",
    "test:account-ui": "node tests/figma/account-smoke.mjs && node tests/figma/account-failure-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
