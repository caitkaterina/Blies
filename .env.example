# Persistent Node host: sqlite. Vercel: disabled (never use an ephemeral filesystem adapter).
BLIES_STORAGE_MODE=sqlite
# Non-secret defaults and required setting names. Never commit a populated .env file.
BLIES_DATA_DIR=/workspace/blies-private
BLIES_SITE_URL=http://localhost:3000
BLIES_LAUNCH_APPROVED=false
# Optional privacy-focused analytics; requires consent and network access.
BLIES_ANALYTICS_DOMAIN=
# Approved sender address and a Resend HTTPS-proxy-backed API credential.
BLIES_EMAIL_FROM=
BLIES_EMAIL_API_KEY=
# A real HTTPS malware scanner accepting raw bytes and returning {"clean":true}.
BLIES_SCAN_URL=
BLIES_SCAN_KEY=
# Configure these as protected LOCAL runtime secrets, not proxy placeholders.
BLIES_ADMIN_EMAIL=
BLIES_ADMIN_PASSWORD_HASH=
BLIES_ADMIN_TOTP_SECRET=
BLIES_SESSION_SECRET=
# Optional protected JSON accounts: [{email,role,passwordHash,totpSecret}].
BLIES_STAFF_ACCOUNTS_JSON=
# Enable only when a trusted gateway strips client X-Real-IP and sets its own.
BLIES_TRUST_PROXY=false

# Managed production mode: supabase. Keep sqlite for existing durable local development.
# Set BLIES_STORAGE_MODE=supabase only after reviewing/applying the migration.
BLIES_SUPABASE_URL=
# Server-only service-role credential; never use a VITE_ or NEXT_PUBLIC_ prefix.
BLIES_SUPABASE_SERVICE_ROLE_KEY=
# Exact comma-separated HTTPS frontend origins, no wildcards or paths.
# Used only for public submissions; administrator endpoints remain same-origin + CSRF.
BLIES_PUBLIC_ORIGINS=
